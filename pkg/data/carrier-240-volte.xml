<?xml version="1.0" encoding="UTF-8"?>
<CarrierConfiguration xmlns="http://www.rim.com/CarrierConfig/2012-01" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.rim.com/CarrierConfig/2012-01/CarrierConfiguration.xsd">
  <CarrierDataConfiguration version="1.0.0.0">
    <Name>T-Mobile Poland (PTC)</Name>
    <Description>Configuration for T-Mobile Poland (PTC) data</Description>
    <CarrierID>240</CarrierID>
    <VendorID>234</VendorID>
    <ServiceConfiguration>
      <Name>lte_admin</Name>
      <Description>Configuration for lte_admin data</Description>
      <AlwaysOn>true</AlwaysOn>
      <LTEAttachService>true</LTEAttachService>
      <NetworkInterfaceConfiguration>
        <IPConfiguration>
          <NetworkServiceFilter>LTE</NetworkServiceFilter>
          <Type>IPv4</Type>
          <ProtectRouting>true</ProtectRouting>
          <ZeroRated>true</ZeroRated>
        </IPConfiguration>
      </NetworkInterfaceConfiguration>
      <BearerManagementTimer/>
      <RadioAccessTechnology>
        <NetworkServiceFilter>LTE</NetworkServiceFilter>
        <APN></APN>
      </RadioAccessTechnology>
      <EPDGConfiguration/>
    </ServiceConfiguration>
    <ServiceConfiguration>
      <Name>internet</Name>
      <Description>Configuration for internet data</Description>
      <AlwaysOn>true</AlwaysOn>
      <TCPKeepAlive></TCPKeepAlive>
      <NetworkInterfaceConfiguration>
        <IPConfiguration>
          <Type>IPv4</Type>
        </IPConfiguration>
      </NetworkInterfaceConfiguration>
      <BearerManagementTimer/>
      <RadioAccessTechnology>
        <APN>internet</APN>
      </RadioAccessTechnology>
      <EPDGConfiguration/>
    </ServiceConfiguration>
    <ServiceConfiguration>
      <Name>mms</Name>
      <Description>Configuration for mms data</Description>
      <NetworkInterfaceConfiguration>
        <IPConfiguration>
          <Type>IPv4</Type>
        </IPConfiguration>
      </NetworkInterfaceConfiguration>
      <BearerManagementTimer/>
      <RadioAccessTechnology>
        <APN>mms</APN>
      </RadioAccessTechnology>
      <EPDGConfiguration/>
    </ServiceConfiguration>
    <ServiceConfigurationAlias>
      <Name>a_gps</Name>
      <Reference>internet</Reference>
    </ServiceConfigurationAlias>
    <ServiceConfigurationAlias>
      <Name>bip</Name>
      <Reference>internet</Reference>
    </ServiceConfigurationAlias>
    <ServiceConfigurationAlias>
      <Name>bip_2</Name>
      <Reference>internet</Reference>
    </ServiceConfigurationAlias>
    <ServiceConfigurationAlias>
      <Name>bip_3</Name>
      <Reference>internet</Reference>
    </ServiceConfigurationAlias>
    <ServiceConfigurationAlias>
      <Name>bip_4</Name>
      <Reference>internet</Reference>
    </ServiceConfigurationAlias>
    <ServiceConfigurationAlias>
      <Name>bip_5</Name>
      <Reference>internet</Reference>
    </ServiceConfigurationAlias>
    <ServiceConfigurationAlias>
      <Name>blackberry</Name>
      <Reference>internet</Reference>
    </ServiceConfigurationAlias>
    <ServiceConfigurationAlias>
      <Name>carrier_800</Name>
      <Reference>internet</Reference>
    </ServiceConfigurationAlias>
    <ServiceConfigurationAlias>
      <Name>carrier_admin</Name>
      <Reference>internet</Reference>
    </ServiceConfigurationAlias>
    <ServiceConfigurationAlias>
      <Name>carrier_apps</Name>
      <Reference>internet</Reference>
    </ServiceConfigurationAlias>
    <ServiceConfiguration>
      <Name>ims</Name>
      <Description>T-Mobile Poland IMS for VoLTE</Description>
      <Connectivity>
        <NotRoaming>AllowIfDataServicesEnabledOrVoLTECallActive</NotRoaming>
        <Roaming>AllowIfDataRoamingEnabledOrVoLTECallActive</Roaming>
      </Connectivity>
      <AlwaysOn>false</AlwaysOn>
      <NetworkInterfaceConfiguration>
        <IPConfiguration>
          <Type>IPv4v6</Type>
          <ProtectRouting>true</ProtectRouting>
          <DisableDAD>true</DisableDAD>
        </IPConfiguration>
      </NetworkInterfaceConfiguration>
      <BearerManagementTimer><KeepAlive>0</KeepAlive></BearerManagementTimer>
      <RadioAccessTechnology><APN>ims</APN></RadioAccessTechnology>
      <IMSConfiguration>
        <RequestPCSCFViaPCO>true</RequestPCSCFViaPCO>
        <RequestSignallingBearerViaPCO>true</RequestSignallingBearerViaPCO>
        <MediaConfiguration>
          <AudioCodecs>AMR-WB,AMR</AudioCodecs>
        </MediaConfiguration>
      </IMSConfiguration>
    </ServiceConfiguration>
    <ServiceConfigurationAlias>
      <Name>plan_admin</Name>
      <Reference>internet</Reference>
    </ServiceConfigurationAlias>
    <ServiceConfigurationAlias>
      <Name>rim_admin</Name>
      <Reference>internet</Reference>
    </ServiceConfigurationAlias>
    <ServiceConfigurationAlias>
      <Name>software_update</Name>
      <Reference>internet</Reference>
    </ServiceConfigurationAlias>
    <ServiceConfigurationAlias>
      <Name>streaming</Name>
      <Reference>internet</Reference>
    </ServiceConfigurationAlias>
    <ServiceConfigurationAlias>
      <Name>supplementary_services_admin</Name>
      <Reference>internet</Reference>
    </ServiceConfigurationAlias>
    <ServiceConfigurationAlias>
      <Name>tethering</Name>
      <Reference>internet</Reference>
    </ServiceConfigurationAlias>
    <ServiceConfigurationAlias>
      <Name>tethering_2</Name>
      <Reference>internet</Reference>
    </ServiceConfigurationAlias>
    <ServiceConfigurationAlias>
      <Name>tethering_entitlement</Name>
      <Reference>internet</Reference>
    </ServiceConfigurationAlias>
    <ServiceConfigurationAlias>
      <Name>tethering_user</Name>
      <Reference>internet</Reference>
    </ServiceConfigurationAlias>
    <ServiceConfigurationAlias>
      <Name>vvm</Name>
      <Reference>internet</Reference>
    </ServiceConfigurationAlias>
  </CarrierDataConfiguration>
  <CarrierECCConfiguration/>
  <CarrierLanguageConfiguration>
    <ActivationLanguages extendedList="All" reducedList="en_GB,en_US,pl_PL" default="pl_PL"/>
  </CarrierLanguageConfiguration>
  <CarrierManagerConfiguration/>
  <CarrierAuthmanConfiguration/>
  <CarrierUIConfiguration>
    <ShowVoLTEIcon>true</ShowVoLTEIcon>
  </CarrierUIConfiguration>
</CarrierConfiguration>
